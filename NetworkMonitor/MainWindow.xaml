<Window x:Class="NetworkMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetworkMonitor.ViewModels"
        xmlns:conv="clr-namespace:NetworkMonitor.Converters"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="NetworkShow - сетевой мониторинг трафика" Height="820" Width="1400"
        WindowStartupLocation="CenterScreen" MinWidth="1000" MinHeight="600">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:BytesConverter x:Key="BytesConverter" />
        <conv:ShareToggleTextConverter x:Key="ShareToggleText" />

        <ContextMenu x:Key="ConnectionRowMenu">
            <MenuItem Header="Копировать" Click="CopyConnection_Click" />
            <MenuItem Header="Копировать IP" Click="CopyIp_Click" />
            <MenuItem Header="Перейти к файлу процесса" Click="OpenProcessFile_Click" />
            <Separator />
            <MenuItem Header="В чёрный список" Click="BlacklistIp_Click" />
            <MenuItem Header="В белый список" Click="WhitelistIp_Click" />
        </ContextMenu>

        <ContextMenu x:Key="RemoteIpRowMenu">
            <MenuItem Header="Копировать" Click="CopyRemoteIp_Click" />
            <MenuItem Header="Копировать IP" Click="CopyIp_Click" />
            <MenuItem Header="Перейти к файлу процесса" Click="OpenProcessFileRemoteIp_Click" />
            <Separator />
            <MenuItem Header="В чёрный список" Click="BlacklistIp_Click" />
            <MenuItem Header="В белый список" Click="WhitelistIp_Click" />
        </ContextMenu>

        <!-- Копирование из таблиц: значение ячейки, строка, вся таблица -->
        <ContextMenu x:Key="CellCopyMenu">
            <MenuItem Header="Копировать значение ячейки" Click="CopyCell_Click" />
            <MenuItem Header="Копировать строку" Click="CopyRow_Click" />
            <MenuItem Header="Копировать всю таблицу (с заголовками)" Click="CopyTable_Click" />
        </ContextMenu>

        <Style x:Key="ConnectionRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="ContextMenu" Value="{StaticResource ConnectionRowMenu}" />
            <Setter Property="ToolTip" Value="{Binding Endpoint}" />
        </Style>

        <Style x:Key="LanDeviceRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKnown}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotificationRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityText}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityText}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShareRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Denied}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Denied}" Value="False" />
                        <Condition Binding="{Binding IsTunnel}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RemoteIpRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="ContextMenu" Value="{StaticResource RemoteIpRowMenu}" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True"
               TextElement.Foreground="{DynamicResource ForegroundBrush}"
               TextElement.FontFamily="Segoe UI"
               Background="{DynamicResource BgBrush}">

        <!-- Top toolbar: только управление захватом; настройки — во всплывающем окне -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Интерфейс" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox Width="320" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                              ToolTip="Сетевой адаптер для захвата. ★ — основной (со шлюзом), зелёная скорость — идёт трафик.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- Закрытый список: одна строка -->
                                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Выпадающий список: имя, адреса и живая скорость -->
                                    <StackPanel Margin="0,3">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUp}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="  ★ основной" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding RateText}" FontSize="11" Foreground="{DynamicResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Command="{Binding RefreshInterfacesCommand}"
                            Style="{DynamicResource GhostButton}" Margin="4,0,0,0"
                            ToolTip="Обновить список интерфейсов (после подключения VPN или адаптера)"
                            IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolConverter}}" />
                    <Button Content="▶  Запустить" Command="{Binding StartCommand}" Margin="10,0,4,0"
                            IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolConverter}}" />
                    <Button Content="■  Стоп" Command="{Binding StopCommand}" Style="{DynamicResource DangerButton}"
                            IsEnabled="{Binding IsCapturing}" />
                    <Button Content="Пауза" Command="{Binding TogglePauseCommand}" Style="{DynamicResource GhostButton}"
                            Margin="4,0,0,0" IsEnabled="{Binding IsCapturing}" />
                    <Rectangle Width="1" Margin="12,4" Fill="{DynamicResource BorderBrush}" />
                    <Button Content="Очистить" Command="{Binding ClearCommand}" Style="{DynamicResource GhostButton}"
                            ToolTip="Сбросить накопленные соединения и счётчики" />
                    <Button Content="Экспорт" Command="{Binding ExportCommand}" Style="{DynamicResource GhostButton}" Margin="4,0,0,0"
                            ToolTip="Сохранить текущие соединения в файл (папка logs)" />
                </StackPanel>

                <!-- Состояние и скорость — всегда на виду -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="Остановлен" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Text" Value="Захват идёт" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="↓" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SpeedInText}" FontWeight="SemiBold" FontSize="14" MinWidth="88" Margin="4,0,14,0" VerticalAlignment="Center"
                               ToolTip="Входящая скорость" />
                    <TextBlock Text="↑" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SpeedOutText}" FontWeight="SemiBold" FontSize="14" MinWidth="88" Margin="4,0,0,0" VerticalAlignment="Center"
                               ToolTip="Исходящая скорость" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="⚙  Настройки" Style="{DynamicResource GhostButton}" Click="SettingsButton_Click" />
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-230">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16" Width="340" Margin="6,4,10,12"
                                TextElement.Foreground="{DynamicResource ForegroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Настройки" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

                                <CheckBox IsChecked="{Binding DetectAnomalies}" Content="Обнаруживать аномалии" FontWeight="SemiBold" />
                                <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="22,2,0,10"
                                           Text="Сканирование портов, подбор пароля, beaconing, всплески исходящего, новые процессы и слушающие порты, входы Windows (RDP/сеть)." />

                                <CheckBox IsChecked="{Binding CollectSites}" Content="Определять сайты (SNI, DNS)" FontWeight="SemiBold" />
                                <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="22,2,0,10"
                                           Text="Домены из TLS/QUIC и DNS-запросов. Без этого флажка домены не читаются и не показываются." />

                                <CheckBox IsChecked="{Binding UseThreatFeed}" Content="Фид угроз (abuse.ch)" FontWeight="SemiBold" />
                                <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="22,2,0,10"
                                           Text="Раз в 12 ч скачивает список IP ботнет-серверов и предупреждает о соединениях с ними. Делает HTTPS-запрос во внешнюю сеть." />

                                <CheckBox IsChecked="{Binding LogToFile}" Content="Писать трафик в лог-файл" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                                    <TextBlock Text="Формат:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Width="90" ItemsSource="{Binding LogFormatOptions}" SelectedItem="{Binding LogFormat}" />
                                </StackPanel>

                                <Separator Margin="0,12" />
                                <TextBlock Text="Автозапуск" FontWeight="Bold" Margin="0,0,0,6" />
                                <CheckBox IsChecked="{Binding AutostartWithWindows}" Content="Запускать вместе с Windows" FontWeight="SemiBold" />
                                <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="22,2,0,8"
                                           Text="Через планировщик заданий с правами администратора (программа без них не видит ETW и журнал безопасности)." />
                                <CheckBox IsChecked="{Binding StartMinimized}" Content="При автозапуске сворачивать в трей" Margin="0,0,0,6" />
                                <CheckBox IsChecked="{Binding AutoStartCapture}" Content="Начинать захват при запуске программы" />

                                <Separator Margin="0,12" />
                                <TextBlock Text="Хранение данных" FontWeight="Bold" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Удалять логи старше:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="120" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding LogRetention}" />
                                </StackPanel>
                                <Button Content="Очистка данных за период…" Click="OpenCleanup_Click" Style="{DynamicResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" />

                                <Separator Margin="0,12" />
                                <Button Content="Сменить тему (тёмная / светлая)" Command="{Binding ToggleThemeCommand}"
                                        Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Всего ↓ " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding TotalBytesInText}" Margin="0,0,10,0" />
                    <TextBlock Text="↑ " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding TotalBytesOutText}" Margin="0,0,16,0" />
                    <TextBlock Text="Соединения: " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding ConnectionCount}" Margin="0,0,12,0" />
                    <TextBlock Text="Пакеты: " Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding TotalPackets}" Margin="0,0,12,0" />
                    <TextBlock Text="Потеряно: " Foreground="{DynamicResource MutedBrush}"
                               ToolTip="Пакеты, не успевшие обработаться (очередь приложения + буфер драйвера Npcap)" />
                    <TextBlock Text="{Binding DroppedPackets}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">

                    <GroupBox Header="Фильтры (Соединения / IP-адреса)">
                        <StackPanel>
                            <TextBlock Text="Поиск" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,0,8" />

                            <TextBlock Text="IP содержит" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding IpFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,0,8" />

                            <TextBlock Text="Диапазон IP (от → до)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding IpRangeFrom, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                <TextBox Grid.Column="2" Text="{Binding IpRangeTo, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            </Grid>

                            <TextBlock Text="Процесс" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Протокол" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding ProtocolFilter}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Зона" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding ScopeFilter}" />
                                </StackPanel>
                            </Grid>

                            <CheckBox IsChecked="{Binding HideUnknownProcess}" Content="Скрыть unknown" Margin="0,0,0,8" />

                            <TextBlock Text="Группировка" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding GroupingOptions}" SelectedItem="{Binding SelectedGrouping}" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="ЧС" Command="{Binding AddBlacklistCommand}" Style="{DynamicResource DangerButton}" Margin="0,0,4,0"
                                        ToolTip="Добавить IP из поля 'IP содержит' в чёрный список" />
                                <Button Content="БС" Command="{Binding AddWhitelistCommand}" Style="{DynamicResource GhostButton}"
                                        ToolTip="Добавить IP из поля 'IP содержит' в белый список" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Топ IP (по объёму)">
                        <ItemsControl ItemsSource="{Binding TopIps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Топ процессов">
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- Tabs -->
            <TabControl Grid.Column="1">
                <TabItem Header="Соединения">
                    <!-- IsVirtualizingWhenGrouping: группировка иначе отключает виртуализацию,
                         и выбор «По процессу» на тысячах строк замораживает UI -->
                    <Grid>
                    <DataGrid x:Name="ConnectionsGrid" CellEditEnding="AliasCellEditEnding" ItemsSource="{Binding ConnectionsView}" RowStyle="{StaticResource ConnectionRowStyle}"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Зона" Binding="{Binding ScopeText}" Width="80" />
                            <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessName}" Width="140" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                            <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="60" />
                            <DataGridTextColumn Header="Сервис" Binding="{Binding Service}" Width="90" />
                            <DataGridTextColumn Header="Приложение" Binding="{Binding AppLabel}" Width="120" />
                            <DataGridTextColumn Header="Удалённый" Binding="{Binding RemoteEndpoint}" Width="170" />
                            <DataGridTextColumn Header="Протокол" Binding="{Binding AppProtoText, Mode=OneWay}" Width="75" />
                            <DataGridTextColumn Header="Страна" Binding="{Binding Country, Mode=OneWay}" Width="60" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, Mode=OneWay}" Width="140" />
                            <DataGridTextColumn x:Name="ConnAliasColumn" Header="Имя ✎" Binding="{Binding Alias, Mode=OneWay}" Width="130" />
                            <DataGridTextColumn x:Name="SniColumn" Header="SNI / Хост" Binding="{Binding SniOrHost}" Width="*" MinWidth="200" />
                            <DataGridTextColumn Header="Пакеты" Binding="{Binding Packets}" Width="80" />
                            <DataGridTextColumn Header="↓" Binding="{Binding BytesIn, Converter={StaticResource BytesConverter}}" Width="90" />
                            <DataGridTextColumn Header="↑" Binding="{Binding BytesOut, Converter={StaticResource BytesConverter}}" Width="90" />
                            <DataGridTextColumn Header="Всего" Binding="{Binding Bytes, Converter={StaticResource BytesConverter}}" Width="100" />
                            <DataGridTextColumn Header="Последний" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Захват не запущен. Выберите сетевой интерфейс сверху и нажмите «Запустить»."
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               TextAlignment="Center" FontSize="14" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCapturing}" Value="False" />
                                            <Condition Binding="{Binding ConnectionCount}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </TabItem>

                <TabItem Header="IP-адреса">
                    <DataGrid x:Name="RemoteIpsGrid" CellEditEnding="AliasCellEditEnding" ItemsSource="{Binding RemoteIpsView}" RowStyle="{StaticResource RemoteIpRowStyle}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="140" />
