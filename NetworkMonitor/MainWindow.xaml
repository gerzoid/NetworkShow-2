                                    ToolTip="Пометить устройство как своё: уведомления о нём прекратятся" />
                            <Button Content="Доверять всем" Command="{Binding TrustAllCommand}" Style="{DynamicResource GhostButton}" Margin="4,0,0,0"
                                    ToolTip="Пометить как доверенные все найденные сейчас устройства" />
                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                        <DataGrid x:Name="LanGrid" CellEditEnding="AliasCellEditEnding" Grid.Row="1" ItemsSource="{Binding Devices}" ContextMenu="{StaticResource CellCopyMenu}" PreviewMouseRightButtonDown="CopyGrid_PreviewRightButtonDown" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" RowStyle="{StaticResource LanDeviceRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding StatusText}" Width="95" />
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120" SortMemberPath="IpSort" />
                                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140" />
                                <DataGridTextColumn Header="Производитель" Binding="{Binding Vendor}" Width="190" />
                                <DataGridTextColumn Header="Тип (предположительно)" Binding="{Binding DeviceType}" Width="250" />
                                <DataGridTextColumn x:Name="LanNameColumn" Header="Имя ✎" Binding="{Binding Name, Mode=OneWay}" Width="170" />
                                <DataGridTextColumn Header="Признаки (DHCP / mDNS / SSDP)" Binding="{Binding HintsText}" Width="*" MinWidth="200" />
                                <DataGridTextColumn Header="Доверие" Binding="{Binding TrustText}" Width="100" />
                                <DataGridTextColumn Header="Впервые" Binding="{Binding FirstSeen, StringFormat=dd.MM HH:mm}" Width="95" />
                                <DataGridTextColumn Header="Последний раз" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="105" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="История" IsSelected="{Binding History.IsActive, Mode=TwoWay}">
                    <Grid DataContext="{Binding History}" Margin="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}" />
                            <ComboBox Width="110" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" />
                            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{DynamicResource MutedBrush}" />
                            <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="Процесс, адрес, домен, категория, страна, провайдер, протокол или текст события" />
                            <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" />
                            <Button Content="Отчёт за 7 дней" Command="{Binding ReportCommand}" Margin="4,0,0,0" ToolTip="Собрать HTML-отчёт (топ процессов, сайтов, стран, качество связи, события) и открыть в браузере" />
                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                        <TabControl Grid.Row="1">
                            <TabItem Header="Соединения">
                                <DataGrid ItemsSource="{Binding Flows}" IsReadOnly="True" AutoGenerateColumns="False" ContextMenu="{StaticResource CellCopyMenu}" PreviewMouseRightButtonDown="CopyGrid_PreviewRightButtonDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Последний" Binding="{Binding LastSeen}" Width="140" />
                                        <DataGridTextColumn Header="Процесс" Binding="{Binding Process}" Width="130" />
                                        <DataGridTextColumn Header="Адрес / сайт" Binding="{Binding Name}" Width="*" MinWidth="200" />
                                        <DataGridTextColumn Header="Протокол" Binding="{Binding AppProto}" Width="80" />
                                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="160" />
                                        <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="60" />
                                        <DataGridTextColumn Header="Провайдер (ASN)" Binding="{Binding Asn}" Width="170" />
                                        <DataGridTextColumn Header="&#x2193;" Binding="{Binding BytesIn, Converter={StaticResource BytesConverter}}" Width="85" />
                                        <DataGridTextColumn Header="&#x2191;" Binding="{Binding BytesOut, Converter={StaticResource BytesConverter}}" Width="85" />
                                        <DataGridTextColumn Header="RTT" Binding="{Binding RttText}" Width="65" />
                                        <DataGridTextColumn Header="Повторы" Binding="{Binding Retransmits}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="События">
                                <DataGrid ItemsSource="{Binding Events}" IsReadOnly="True" AutoGenerateColumns="False" ContextMenu="{StaticResource CellCopyMenu}" PreviewMouseRightButtonDown="CopyGrid_PreviewRightButtonDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="140" />
                                        <DataGridTextColumn Header="Уровень" Binding="{Binding Severity}" Width="90" />
                                        <DataGridTextColumn Header="Событие" Binding="{Binding Title}" Width="260" />
                                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
                <TabItem Header="Имена адресов">
                    <Grid DataContext="{Binding IpNames}" Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="IP:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}" />
                            <TextBox Width="160" Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Имя:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{DynamicResource MutedBrush}" />
                            <TextBox Width="240" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Добавить / изменить" Command="{Binding AddCommand}" Margin="8,0,0,0" />
                            <Button Content="Удалить выбранное" Command="{Binding DeleteSelectedCommand}" Style="{DynamicResource GhostButton}" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}" />
                            <TextBox Width="220" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}"
                                       Text="Имя можно задать и прямо в таблицах «Соединения» / «IP-адреса» (двойной клик по ячейке «Имя ✎») и в «Устройства (ARP)»." />
                        </StackPanel>
                        <DataGrid x:Name="NamesGrid" Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="False" CellEditEnding="AliasCellEditEnding" BeginningEdit="NamesGrid_BeginningEdit"
                                  ContextMenu="{StaticResource CellCopyMenu}" PreviewMouseRightButtonDown="CopyGrid_PreviewRightButtonDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="220" />
                                <DataGridTextColumn x:Name="NamesNameColumn" Header="Имя ✎" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="220" />
                                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="260" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Списки IP">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource MutedBrush}"
                                       Text="Чёрный список — тревога при любом соединении. Белый — адреса, которые детекторы не считают подозрительными. Добавить: введите IP или CIDR в поле «IP содержит» слева и нажмите «ЧС» / «БС», либо правый клик по строке в таблицах." />
                            <StackPanel Grid.Row="1" Grid.Column="0">
                    <GroupBox Header="Чёрный список">
                        <StackPanel>
                            <TextBlock Text="пусто" Foreground="{DynamicResource MutedBrush}" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BlacklistEntries.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding BlacklistEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="✕" Padding="4,0" Margin="4,0,0,0"
                                                    Style="{DynamicResource GhostButton}" ToolTip="Удалить из чёрного списка"
                                                    Command="{Binding DataContext.RemoveBlacklistEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                    <GroupBox Header="Белый список">
                        <StackPanel>
                            <TextBlock Text="пусто" Foreground="{DynamicResource MutedBrush}" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WhitelistEntries.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding WhitelistEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="✕" Padding="4,0" Margin="4,0,0,0"
                                                    Style="{DynamicResource GhostButton}" ToolTip="Удалить из белого списка"
                                                    Command="{Binding DataContext.RemoveWhitelistEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

    </DockPanel>
</Window>
