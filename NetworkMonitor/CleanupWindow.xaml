<Window x:Class="NetworkMonitor.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Очистка данных" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" TextElement.Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="20,16,20,18">
        <TextBlock Text="Очистка данных за период" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"
                   Text="Удаляет накопленные данные старше выбранного периода. Настройки, доверенные устройства и известные процессы не затрагиваются." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="PeriodBox" Width="190" SelectionChanged="Options_Changed" />
        </StackPanel>

        <TextBlock Text="На диске (папка logs)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <CheckBox x:Name="TrafficBox" Content="Логи трафика (traffic_*)" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,2" />
        <CheckBox x:Name="NotifyLogBox" Content="Журнал уведомлений (notifications.log)" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,2" />
        <CheckBox x:Name="ExportsBox" Content="Экспорты соединений и аналитики" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,2" />
        <CheckBox x:Name="CrashBox" Content="Журнал ошибок (crash.log)" IsChecked="False" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,2" />

        <TextBlock Text="В программе (память)" FontWeight="SemiBold" Margin="0,12,0,4" />
        <CheckBox x:Name="ConnBox" Content="Неактивные соединения и статистика по ним" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,2" />
        <CheckBox x:Name="NotesBox" Content="Уведомления в окне программы" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,2" />

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,16,0,0">
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CleanButton" Content="Очистить" Click="Clean_Click" Style="{DynamicResource DangerButton}" Padding="18,6" />
            <Button Content="Закрыть" Click="Close_Click" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" Padding="18,6" />
        </StackPanel>
    </StackPanel>
</Window>
